	<parameter name="District" class="java.lang.String">
		<defaultValueExpression><![CDATA["CHK"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[-- Teacher training records with no year completed, listed at each teacher's most recent location in the warehouse.
SELECT [tSurname] + ', ' + [tGiven] AS [Teacher]
      ,LL.[TID]
      ,LL.[SchNo]
      ,LL.schName
      ,LL.dID
      ,LL.dName
      ,ROW_NUMBER() OVER (PARTITION BY LL.TID ORDER BY [trQual]) AS TeacherRow
      ,[trYear]
      ,[trComplete]
      ,[trQual]
      ,[codeDescription]
      ,[codeGroup]
      ,[trInstitution]
  FROM [dbo].[TeacherIdentity] AS [TI]
  INNER JOIN [dbo].[TeacherTraining] AS [TT] ON [TI].[tID] = [TT].[tID]
  INNER JOIN [dbo].[lkpTeacherQual] AS [TQ] ON [TT].[trQual] = [TQ].[codeCode]
  INNER JOIN
  ( -- Latest location of each teacher
  SELECT TID, SchNo, schName, dName, dID
  FROM (
    SELECT TL.TID, TL.SchNo, S.schName, D.dName, D.dID
          ,ROW_NUMBER() OVER (PARTITION BY TL.TID ORDER BY TL.SurveyYear DESC, TL.SchNo) AS rn
    FROM [warehouse].[TeacherLocation] TL
    INNER JOIN Schools S ON TL.SchNo = S.schNo
    INNER JOIN Islands I ON S.iCode = I.iCode
    INNER JOIN Districts D ON I.iGroup = D.dID
  ) loc
  WHERE rn = 1
  ) AS LL ON [TI].[tID] = LL.TID
  WHERE trYear IS NULL
    AND LL.dID = $P{District}
  ORDER BY LL.dName, LL.schName, [tSurname], [tGiven], LL.[TID], [trQual]]]>
	</queryString>
	<field name="Teacher" class="java.lang.String"/>
	<field name="TID" class="java.lang.Integer"/>
	<field name="SchNo" class="java.lang.String"/>
	<field name="schName" class="java.lang.String"/>
	<field name="dID" class="java.lang.String"/>
	<field name="dName" class="java.lang.String"/>
	<field name="TeacherRow" class="java.lang.Long"/>
	<field name="trYear" class="java.lang.Integer"/>
	<field name="trComplete" class="java.lang.Boolean"/>
	<field name="trQual" class="java.lang.String"/>
	<field name="codeDescription" class="java.lang.String"/>
	<field name="codeGroup" class="java.lang.String"/>
	<field name="trInstitution" class="java.lang.String"/>
	<variable name="DistrictTeachers" class="java.lang.Integer" resetType="Group" resetGroup="District" calculation="Sum">
		<variableExpression><![CDATA[$F{TeacherRow} == 1 ? 1 : 0]]></variableExpression>
