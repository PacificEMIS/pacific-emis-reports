	<parameter name="Year" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[2024]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[WITH QualDefs AS (
    -- Qualification definitions in force for the chosen year: lkpTeacherQual, overridden by the
    -- latest surveyYearTeacherQual row at or before that year (mirrors pTeacherRead.TeacherQualCert)
    SELECT Qual, Description, Certified, DurationYears
    FROM (
        SELECT Q.codeCode AS Qual,
               Q.codeDescription AS Description,
               CAST(COALESCE(YQ.ytqCertified, Q.codeCertified) AS int) AS Certified,
               COALESCE(NULLIF(Q.codeDurationYears, 0), 9999) AS DurationYears,
               ROW_NUMBER() OVER (PARTITION BY Q.codeCode ORDER BY YQ.svyYear DESC) AS rn
        FROM lkpTeacherQual Q
        LEFT JOIN surveyYearTeacherQual YQ ON YQ.ytqQual = Q.codeCode AND YQ.svyYear <= $P{Year}
    ) d
    WHERE rn = 1
),
HeldQuals AS (
    -- Every qualification code ever recorded for a teacher, and where it came from
    SELECT TS.tID, U.Qual, SS.svyYear AS QualYear,
           'Census ' + CAST(SS.svyYear AS nvarchar(4)) AS Source, 2 AS SourceRank,
           CAST(NULL AS nvarchar(50)) AS Institution
    FROM TeacherSurvey TS
    INNER JOIN SchoolSurvey SS ON TS.ssID = SS.ssID
    CROSS APPLY (VALUES (TS.tchQual), (TS.tchEdQual)) U(Qual)
    WHERE U.Qual IS NOT NULL AND SS.svyYear <= $P{Year}
    UNION ALL
    SELECT TT.tID, TT.trQual, COALESCE(TT.trYear, 0),
           'Training record', 1, TT.trInstitution
    FROM TeacherTraining TT
    WHERE TT.trQual IS NOT NULL AND COALESCE(TT.trYear, 0) <= $P{Year}
),
CertifyingQuals AS (
    -- Held qualifications that confer certification, with their validity window
    SELECT H.tID, H.Qual, D.Description, H.Source, H.SourceRank, H.Institution,
           H.QualYear AS ValidFrom,
           CASE WHEN D.DurationYears = 9999 THEN NULL ELSE H.QualYear + D.DurationYears - 1 END AS ValidTo,
           CASE WHEN D.DurationYears = 9999 OR $P{Year} <= H.QualYear + D.DurationYears - 1 THEN 1 ELSE 0 END AS IsCurrent
    FROM HeldQuals H
    INNER JOIN QualDefs D ON D.Qual = H.Qual
    WHERE D.Certified = 1
),
CertPick AS (
    -- One qualification per teacher: a current certification first (training record preferred over census,
    -- then the one that expires last), otherwise the most recently expired one
    SELECT tID, Qual, Description, Institution, ValidFrom, ValidTo, IsCurrent
    FROM (
        SELECT *, ROW_NUMBER() OVER (
                    PARTITION BY tID
                    ORDER BY IsCurrent DESC, SourceRank,
                             CASE WHEN ValidTo IS NULL THEN 0 ELSE 1 END, ValidTo DESC, ValidFrom) AS rn
        FROM CertifyingQuals
    ) c
    WHERE rn = 1
),
CertSource AS (
    -- Every record that holds the chosen qualification, e.g. 'Training record, Census 2018-2024'
    SELECT P.tID, P.Qual, P.Description, P.Institution, P.ValidFrom, P.ValidTo, P.IsCurrent,
           STUFF(
               CASE WHEN MAX(CASE WHEN Q.SourceRank = 1 THEN 1 ELSE 0 END) = 1 THEN ', Training record' ELSE '' END
             + CASE WHEN MAX(CASE WHEN Q.SourceRank = 2 THEN 1 ELSE 0 END) = 1
                    THEN ', Census ' + CAST(MIN(CASE WHEN Q.SourceRank = 2 THEN Q.ValidFrom END) AS nvarchar(4))
                         + CASE WHEN MIN(CASE WHEN Q.SourceRank = 2 THEN Q.ValidFrom END) <> MAX(CASE WHEN Q.SourceRank = 2 THEN Q.ValidFrom END)
                                THEN '-' + CAST(MAX(CASE WHEN Q.SourceRank = 2 THEN Q.ValidFrom END) AS nvarchar(4)) ELSE '' END
                    ELSE '' END,
             1, 2, '') AS Source
    FROM CertPick P
    INNER JOIN CertifyingQuals Q ON Q.tID = P.tID AND Q.Qual = P.Qual
    GROUP BY P.tID, P.Qual, P.Description, P.Institution, P.ValidFrom, P.ValidTo, P.IsCurrent
)
SELECT
    TL.[TID],
    TI.tSurname + ', ' + TI.tGiven AS Teacher, -- Surname, Given as in the web UI
    TL.[SurveyYear],
    common.SchoolYearStr(CAST(CONCAT(TL.[SurveyYear], '-01-01') AS DATETIME), null) AS SchoolYear,
    [GenderCode] AS G,
    [SurveyRole] AS TeacherRoleCode,
    TR.[codeDescription] AS TeacherRole,
    TL.[SchNo] AS SchoolNo,
    S.schName AS SchoolName,
    D.dName AS District,
    -- Official status computed by warehouse.buildTeacherLocation (pTeacherRead.TeacherQualCert)
    TL.[Certified],
    -- What the school reported on this year's census
    COALESCE(LQ.codeDescription, TS.tchEdQual) AS Certification,
    -- The record behind the computed status
    COALESCE(CS.Description, CS.Qual) AS CertQual,
    CS.Source AS CertSource,
    CS.Institution AS CertInstitution,
    NULLIF(CS.ValidFrom, 0) AS CertValidFrom,
    CS.ValidTo AS CertValidTo,
    CS.IsCurrent AS CertIsCurrent
FROM [warehouse].[TeacherLocation] TL
INNER JOIN TeacherIdentity TI ON TL.TID = TI.tID
INNER JOIN TeacherSurvey TS ON TL.TID = TS.tID -- Does not include any estimate teacher records from TeacherLocation
INNER JOIN SchoolSurvey SS ON TS.ssID = SS.ssID AND SS.svyYear = $P{Year}
INNER JOIN Schools S ON TL.SchNo = S.schNo
INNER JOIN Islands I ON S.iCode = I.iCode
INNER JOIN Districts D ON I.iGroup = D.dID
LEFT OUTER JOIN [dbo].[lkpTeacherRole] TR ON TL.SurveyRole = TR.codeCode
LEFT OUTER JOIN lkpTeacherQual LQ ON TS.tchEdQual = LQ.codeCode
LEFT OUTER JOIN CertSource CS ON CS.tID = TL.TID
WHERE TL.SurveyYear = $P{Year}
  AND TAMX IN ('T','M')
ORDER BY District, SchoolName, Teacher;]]>
	</queryString>
