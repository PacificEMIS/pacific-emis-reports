	<parameter name="Year" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[2024]]></defaultValueExpression>
	</parameter>
	<parameter name="District" class="java.lang.String">
		<defaultValueExpression><![CDATA["CHK"]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[-- Teachers the warehouse places in a school in the chosen year (warehouse.TeacherLocation, including teachers
-- carried forward as estimates), one location per teacher, with every qualification recorded in TeacherTraining.
SELECT LL.dName AS District
      ,LL.SchNo AS SchoolNo
      ,LL.schName AS SchoolName
      ,[TI].tID
      ,[tSurname] + ', ' + [tGiven] AS [Teacher]
      ,ROW_NUMBER() OVER (PARTITION BY [TI].tID ORDER BY [trQual]) AS TeacherRow
      ,[trYear]
      ,[trComplete]
      ,[trQual]
      ,[codeDescription]
      ,[codeGroup]
      ,[trInstitution]
      ,COALESCE(SM.subjName, TT.trMajor) AS trMajor -- trMajor holds a lkpSubjects code
      ,[trEffectiveDate]
      ,[trExpirationDate]
  FROM [dbo].[TeacherIdentity] AS [TI]
  INNER JOIN
  ( -- Location of each teacher in the chosen year
  SELECT TID, SchNo, schName, dName, dID
  FROM (
    SELECT TL.TID, TL.SchNo, S.schName, D.dName, D.dID
          ,ROW_NUMBER() OVER (PARTITION BY TL.TID ORDER BY TL.SchNo) AS rn
    FROM [warehouse].[TeacherLocation] TL
    INNER JOIN Schools S ON TL.SchNo = S.schNo
    INNER JOIN Islands I ON S.iCode = I.iCode
    INNER JOIN Districts D ON I.iGroup = D.dID
    WHERE TL.SurveyYear = $P{Year}
  ) loc
  WHERE rn = 1
  ) AS LL ON [TI].[tID] = LL.TID
  LEFT OUTER JOIN [dbo].[TeacherTraining] AS [TT] ON [TI].[tID] = [TT].[tID]
  LEFT OUTER JOIN [dbo].[lkpTeacherQual] AS [TQ] ON [TT].[trQual] = [TQ].[codeCode]
  LEFT OUTER JOIN [dbo].[lkpSubjects] AS [SM] ON [TT].[trMajor] = [SM].[subjCode]
  WHERE LL.dID = $P{District}
  ORDER BY LL.dName, LL.schName, [tSurname], [tGiven], [TI].[tID], [trQual]]]>
	</queryString>
